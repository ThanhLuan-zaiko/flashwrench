{
  "name": "flashwrench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "realtime": "bun run realtime/server.ts",
    "dev:all": "bun run scripts/dev-all.ts",
    "start:all": "bun run scripts/start-all.ts",
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "check:lines": "bun .github/scripts/check-file-limits.ts",
    "check:all": "bun run lint && bun run type-check && bun run check:lines",
    "test": "bun run test:unit && bun run test:integration && bun run test:regression",
    "test:unit": "bash tests/run-suite.sh tests/unit",
    "test:integration": "bash tests/run-suite.sh tests/integration",
    "test:regression": "bash tests/run-suite.sh tests/regression",
    "seed:admin": "bun scripts/seed-admin.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "cassandra-driver": "^4.9.0",
    "gsap": "^3.15.0",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
