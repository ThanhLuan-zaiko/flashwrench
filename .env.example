SCYLLA_PASSWORD=
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
# encrypted staff temp passwords (32 random bytes, base64)
STAFF_TEMP_SECRET=
# shared realtime gateway (Bun WebSocket, two-way). Publish auth reuses
# AUTH_SECRET; set REALTIME_SECRET only for split-host deployments.
# Browser URL defaults to the page hostname (same host keeps auth cookies
# on the handshake); override only for prod/split-host.
REALTIME_PORT=3001
REALTIME_PUBLISH_URL=http://127.0.0.1:3001/publish
NEXT_PUBLIC_REALTIME_URL=
# seed admin account details
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ENFORCE_SINGLE_ADMIN=
SEED_ADMIN_LOOKBACK_MONTHS=