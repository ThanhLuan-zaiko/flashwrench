SCYLLA_CONTACT_POINTS=
SCYLLA_PORT=
SCYLLA_KEYSPACE=
SCYLLA_LOCAL_DATACENTER=
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
# encrypted staff temp passwords (32 random bytes, base64)
STAFF_TEMP_SECRET=
# SMTP for the guest-access OTP email (see docs/guest-access.md).
# MAIL_HOST + MAIL_FROM are the only required pair; without them the OTP
# endpoint answers 503 instead of pretending to send a code.
# Works with any provider: Gmail (smtp.gmail.com:465 + App Password),
# Resend, Brevo, Mailtrap, or a corporate relay.
MAIL_HOST=
MAIL_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (port 587). Defaults to
# true when MAIL_PORT is 465.
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=FlashWrench
MAIL_TIMEOUT_MS=10000
# Pepper for the stored OTP digest. Falls back to AUTH_SECRET when unset or
# shorter than 32 chars; set it to rotate the OTP pepper independently.
# OTP_SECRET=
# shared realtime gateway (Bun WebSocket, two-way). Publish auth reuses
# AUTH_SECRET; set REALTIME_SECRET only for split-host deployments.
# Browser URL defaults to the page hostname on port 3001 (same host keeps
# auth cookies on the handshake). Behind the Caddyfile, WS rides the same
# domain: NEXT_PUBLIC_REALTIME_URL=wss://<domain>/ws
REALTIME_PORT=3001
REALTIME_PUBLISH_URL=http://127.0.0.1:3001/publish
NEXT_PUBLIC_REALTIME_URL=
# comma-separated browser Origins allowed to upgrade /ws. Required in
# production: TLS ends at Caddy so the gateway sees http:// while the
# browser sends Origin https:// — the allowlist skips that protocol check.
# e.g. REALTIME_ALLOWED_ORIGINS=https://flashwrench.vn
REALTIME_ALLOWED_ORIGINS=
# uploaded image storage (physical files, see docs/media.md).
# Local dev default is ./storage (gitignored, created on first upload).
# Production: point to a persistent volume, e.g. STORAGE_DIR=/data,
# and mount it (docker -v flashwrench-storage:/data).
STORAGE_DIR=
# max upload size in megabytes (default 8)
MEDIA_MAX_MB=
# seed admin account details
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ENFORCE_SINGLE_ADMIN=
SEED_ADMIN_LOOKBACK_MONTHS=

# absolute site origin for Open Graph/canonical URLs in link previews
# (e.g. https://flashwrench.example); defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# in-app DDoS shield / overload gate (second wall behind Cloudflare).
# Default: on in production, off in dev; set true/false to override.
SHIELD_ENABLED=
# per-IP fixed-window limits per traffic class
SHIELD_PAGE_LIMIT=240
SHIELD_API_LIMIT=120
SHIELD_MEDIA_LIMIT=600
SHIELD_AUTH_LIMIT=20
SHIELD_WINDOW_MS=10000
SHIELD_AUTH_WINDOW_MS=60000
# instance-wide admission cap per second (thundering-herd breaker)
SHIELD_GLOBAL_RPS=600
# repeat offenders: N tripped windows inside the strike window earn a
# shared ScyllaDB ban for SHIELD_BAN_SECONDS
SHIELD_BAN_STRIKES=3
SHIELD_STRIKE_WINDOW_MS=60000
SHIELD_BAN_SECONDS=600
# declared Content-Length caps rejected before route handlers run
SHIELD_MAX_JSON_BYTES=1048576
SHIELD_MAX_UPLOAD_BYTES=